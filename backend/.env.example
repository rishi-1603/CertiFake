# Copy this file to backend/.env for local (non-docker-compose) runs, and/or
# create a repo-root .env for `docker-compose up` (compose reads .env from
# the directory docker-compose.yml lives in).
#
# NEVER commit a real .env file. It is already excluded via .gitignore.

# Required: used to sign/verify JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-64-char-hex-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (docker-compose overrides this to point at the postgres service;
# only needed here for running the API outside docker-compose, e.g. `uvicorn
# app.api:app --reload` against a local Postgres or SQLite for quick checks)
DATABASE_URL=postgresql://certifake:password@localhost:5432/certifake_db

# Kafka / MinIO (docker-compose overrides these to the in-network hostnames;
# only needed here for running outside docker-compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
